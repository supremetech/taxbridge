# Copy sang `.env` (gitignored) để chạy local. Firebase CLI KHÔNG nạp file này lên prod
# vì nó nằm ngoài `functions/` — đừng tạo `functions/.env` (CLAUDE.md §8).
OPENAI_API_KEY=
GCLOUD_PROJECT=hackathon-42790

# Zalo Bot Platform. Trên prod lấy từ Secret Manager (firebase functions:secrets:set).
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=

# Chạy với Firestore emulator (tests/smoke/emulator.sh) — bỏ trống khi dùng Firestore thật.
# FIRESTORE_EMULATOR_HOST=localhost:8080
