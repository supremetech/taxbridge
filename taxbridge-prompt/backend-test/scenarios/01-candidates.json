          }
        },
        {
          "id": "e03",
          "seedEvent": {
            "type": "SALE",
            "amount": "${AMT-1}",
            "description": "lech 1 dong, trung ten, khac ngay",
            "counterparty": "chị Lan",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${today+1}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "e01",
          "seedEvent": {
            "type": "SALE",
            "amount": "${AMT-1}",
            "description": "lech 1 dong, khac ten, cung ngay",
            "counterparty": "Hoa Ban",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${MDATE}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "mov",
          "call": "GET /api/money-movements/${movId}"
        }
      ],
      "expect": [
        {
          "rule": "CAND-THRESHOLD",
          "target": "mov",
          "path": "candidates",
          "op": "len",
          "value": 2,
          "note": "chỉ 0.4 và 0.3 vượt ngưỡng"
        },
        {
          "rule": "CAND-SCORE-FORMULA",
          "target": "mov",
          "path": "candidates[?eventId=${e04}].score",
          "op": "approx",
          "value": 0.4
        },
        {
          "rule": "CAND-SCORE-FORMULA",
          "target": "mov",
          "path": "candidates[?eventId=${e03}].score",
          "op": "approx",
          "value": 0.3,
          "note": "biên bao gồm: >= 0.3"
        },
        {
          "rule": "CAND-THRESHOLD",
          "target": "mov",
          "path": "candidates[*].eventId",
          "op": "notContains",
          "value": "${e01}",
          "note": "0.1 phải bị loại; lọt vào ⇒ code dùng score>0 chứ không phải >=0.3 ⇒ hero UC5 hỏng"
        },
        {
          "rule": "CAND-NO-AUTO",
          "target": "mov",
          "path": "matchedEventId",
          "op": "isNull"
        }
      ]
    },
    {
      "variationId": "V3-pool-filter",
      "name": "Bảy mồi nhử: chỉ SALE + CONFIRMED + UNPAID được vào pool",
