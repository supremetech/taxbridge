          },
          "precheck": [
            {
              "path": "status",
              "op": "eq",
              "value": "DONE",
              "onFail": "block",
              "why": "AI không đọc được ảnh CK"
            }
          ]
        },
        {
          "id": "mv0",
          "call": "GET /api/money-movements/${movId}",
          "save": {
            "AMT": "$.amount",
            "MDATE": "$.occurredAt|date"
          }
        },
        {
          "id": "bPaid",
          "seedEvent": {
            "type": "SALE",
