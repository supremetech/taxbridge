          "op": "sameAs",
          "refTarget": "mov",
          "refPath": "candidates[0].eventId",
          "note": "hòa điểm: spec không định nghĩa tie-break, nhưng thứ tự phải ỔN ĐỊNH giữa hai lần đọc"
        },
        {
          "rule": "CAND-ONLY-WHEN-UNMATCHED",
          "target": "list",
          "path": "[0].candidates",
          "op": "len",
          "value": 2,
          "note": "candidates cũng phải có trong danh sách, không chỉ ở detail"
        }
      ]
    },
    {
