    {
      "variationId": "V4-hero-no-candidate",
      "name": "UC5: khoản 380k không khớp đơn 450k nào ⇒ candidates rỗng",
      "mode": "assert",
      "act": [
        {
          "id": "up",
          "capture": {
            "type": "IMAGE_TRANSFER",
            "evidence": "M4"
          },
          "save": {
            "movId": "$.resultId"
          },
          "precheck": [
            {
              "path": "status",
              "op": "eq",
              "value": "DONE",
              "onFail": "block",
              "why": "AI không đọc được ảnh CK 380k"
            }
          ]
        },
        {
          "id": "mov",
          "call": "GET /api/money-movements/${movId}",
          "save": {
            "MDATE": "$.occurredAt|date"
          },
          "precheck": [
            {
              "path": "amount",
              "op": "neq",
              "value": 450000,
              "onFail": "block",
              "why": "AI đọc nhầm thành 450k thì mất ý nghĩa kịch bản"
            }
          ]
        },
        {
          "id": "e450",
          "seedEvent": {
            "type": "SALE",
            "amount": 450000,
            "description": "don ban 450k cho chi Lan",
            "counterparty": "chị Lan",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${MDATE}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "dash",
          "call": "GET /api/dashboard?date=${MDATE}"
        },
        {
          "id": "mov2",
          "call": "GET /api/money-movements/${movId}"
        }
      ],
      "expect": [
        {
          "rule": "CAND-THRESHOLD",
          "target": "mov2",
          "path": "candidates",
          "op": "len",
          "value": 0,
          "note": "chỉ cùng ngày = 0.1 < 0.3; có candidate ở đây là hỏng hero UC5"
        },
        {
          "rule": "CAND-NO-AUTO",
          "target": "mov",
          "path": "status",
          "op": "eq",
          "value": "UNMATCHED"
        },
        {
          "rule": "CAND-NO-AUTO",
          "target": "mov",
          "path": "matchedEventId",
          "op": "isNull"
        },
        {
          "rule": "DASH-BANKIN",
          "target": "dash",
          "path": "bankIn",
          "op": "eq",
          "value": 380000,
          "note": "tiền vào ngân hàng tăng ngay khi capture"
        },
        {
          "rule": "DASH-COUNTS",
          "target": "dash",
          "path": "unmatchedMoneyCount",
          "op": "eq",
          "value": 1
        },
        {
          "rule": "DASH-REVENUE",
          "target": "dash",
          "path": "revenue",
          "op": "eq",
          "value": 450000,
          "note": "doanh thu của ngày chứng từ chỉ gồm đơn bán, không gồm 380k chưa phân loại"
        }
      ]
    },
