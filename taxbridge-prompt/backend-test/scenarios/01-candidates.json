{
  "scenarioId": "SC-CAND",
  "title": "Candidate cho tiền vào: lọc pool, chấm điểm, xếp hạng, không tự ghép",
  "intent": "Thuật toán candidate là trái tim UC4. Lệch trọng số ⇒ gợi ý sai đơn. Lọc pool hỏng ⇒ gợi ý ghép vào đơn đã thu tiền rồi, tiền bị đếm hai lần. Ngưỡng sai ⇒ UC5 hiện candidate rác và hero 'khoản này không khớp đơn nào' tan. Mọi kỳ vọng neo theo ${AMT} là số tiền AI đọc được, không hard-code số trên ảnh — AI đọc lệch thì variation BLOCKED chứ không FAIL.",
  "ruleRefs": [
    "CAND-SCORE-FORMULA",
    "CAND-THRESHOLD",
    "CAND-FILTER-ELIGIBLE",
    "CAND-LIMIT-3",
    "CAND-SORT-DESC",
    "CAND-SHAPE",
    "CAND-NO-AUTO"
  ],
  "isolation": "perVariation",
  "variations": [
    {
      "variationId": "V1-weights",
      "name": "Dò từng trọng số: 1.0 / 0.9 / 0.7",
      "mode": "assert",
      "act": [
        {
          "id": "up",
          "capture": {
            "type": "IMAGE_TRANSFER",
            "evidence": "M1"
          },
          "save": {
            "movId": "$.resultId"
          },
          "precheck": [
            {
              "path": "status",
              "op": "eq",
              "value": "DONE",
              "onFail": "block",
              "why": "AI không đọc được ảnh CK ⇒ không kết luận được gì về backend"
            },
            {
              "path": "resultType",
              "op": "eq",
              "value": "MONEY_MOVEMENT",
              "onFail": "block"
            }
          ]
        },
        {
          "id": "mv0",
          "call": "GET /api/money-movements/${movId}",
          "save": {
            "AMT": "$.amount",
            "MDATE": "$.occurredAt|date"
          }
        },
        {
          "id": "e1",
          "seedEvent": {
            "type": "SALE",
            "amount": "${AMT}",
            "description": "don trung tien trung ten cung ngay",
            "counterparty": "chị Lan",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${MDATE}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "e2",
          "seedEvent": {
            "type": "SALE",
            "amount": "${AMT}",
            "description": "don trung tien trung ten khac ngay",
            "counterparty": "chị Lan",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${today+1}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "e3",
          "seedEvent": {
            "type": "SALE",
            "amount": "${AMT}",
            "description": "don trung tien khac ten cung ngay",
            "counterparty": "Hoa Ban",
            "paymentMethod": "BANK",
            "paymentStatus": "UNPAID",
            "occurredAt": "${MDATE}T08:00:00+07:00",
            "confirm": true
          }
        },
        {
          "id": "mov",
          "call": "GET /api/money-movements/${movId}"
        }
      ],
      "expect": [
        {
          "rule": "CAND-NO-AUTO",
          "target": "mov",
          "path": "status",
          "op": "eq",
          "value": "UNMATCHED"
        },
        {
          "rule": "CAND-NO-AUTO",
          "target": "mov",
          "path": "matchedEventId",
          "op": "isNull"
        },
        {
          "rule": "CAND-LIMIT-3",
          "target": "mov",
          "path": "candidates",
          "op": "len",
          "value": 3
        },
        {
          "rule": "CAND-SCORE-FORMULA",
          "target": "mov",
          "path": "candidates[?eventId=${e1}].score",
          "op": "approx",
          "value": 1.0,
          "note": "0.6 tiền + 0.3 tên + 0.1 cùng ngày"
        },
        {
          "rule": "CAND-SCORE-FORMULA",
          "target": "mov",
          "path": "candidates[?eventId=${e2}].score",
          "op": "approx",
          "value": 0.9,
          "note": "thiếu 0.1 cùng ngày"
        },
        {
          "rule": "CAND-SCORE-FORMULA",
          "target": "mov",
          "path": "candidates[?eventId=${e3}].score",
          "op": "approx",
          "value": 0.7,
          "note": "thiếu 0.3 trùng tên"
        },
        {
          "rule": "CAND-SORT-DESC",
          "target": "mov",
          "path": "candidates[0].eventId",
          "op": "eq",
          "value": "${e1}"
        },
        {
          "rule": "CAND-SORT-DESC",
          "target": "mov",
          "path": "candidates[*].score",
          "op": "monotonicDesc"
        },
        {
          "rule": "CAND-SHAPE",
          "target": "mov",
          "path": "candidates[0].amount",
          "op": "eq",
          "value": "${AMT}"
        },
        {
          "rule": "CAND-SHAPE",
          "target": "mov",
          "path": "candidates[0].description",
          "op": "notNull"
        }
      ]
    },
    {
      "variationId": "V2-threshold",
